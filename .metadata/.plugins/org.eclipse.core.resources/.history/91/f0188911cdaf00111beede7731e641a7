// GPIO B PORT

    @ ----------------------------------------------------
    @ GPIOB_MODER_DIO_Input
    @ ----------------------------------------------------
    .type GPIOB_MODER_DIO_Input, %function
    .thumb_func
GPIOB_MODER_DIO_Input:
	//PB8  LORA DIO
	//00: Input mode
	//01: General purpose output mode
	//10: Alternate function mode
	//11: Analog mode (reset state)
	LDR		R1, =GPIOB_BASE_ADDR
	LDR		R2, =GPIOx_MODER_OFFSET
	ADDS	R1, R2
	LDR		R0, [R1]
	MOVS	R3, 0x3
	LSLS	R3, #16
	MVNS	R3, R3
	ANDS 	R0, R3  	//clear bits
	STR		R0, [R1]
	BX LR

    @ ----------------------------------------------------
    @ GPIOB_PUPDR_DIO_DOWN
    @ ----------------------------------------------------
    .type GPIOB_PUPDR_DIO_DOWN, %function
    .thumb_func
GPIOB_PUPDR_DIO_DOWN:
	//PB8  LORA DIO
	LDR		R1, =GPIOB_BASE_ADDR
	LDR		R2, =GPIOx_PUPDR_OFFSET
	ADDS	R1,	R2
	LDR		R0, [R1]
	MOVS	R2, 0x2
	LSLS	R3, R2, #16
	ORRS	R0, R3
	STR		R0,	[R1]
	BX LR

