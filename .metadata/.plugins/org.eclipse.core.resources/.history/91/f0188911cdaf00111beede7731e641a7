	LDR		R1, =GPIOA_BASE_ADDR
	LDR		R2, =GPIOx_AFRL_OFFSET
	ADDS	R1,	R2
	LDR		R0, [R1]
	#PA1
	MOVS	R2, 0xF
	LSLS	R2, #4
	MVNS	R2,	R2
	ANDS	R0, R2
	MOVS	R2, 0x5
	LSLS	R2, #4
	ORRS	R0, R2
	STR		R0,	[R1]
	BX LR

