    @ ----------------------------------------------------
    @ GPIOA_MODER_Set_Alt_Function
    @ ----------------------------------------------------
    .type GPIOA_MODER_Set_Alt_Function, %function
    .thumb_func
GPIOA_MODER_Set_Alt_Function:
	//PA1	SPI1_SCK
	//PA11	SPI1_MISO
	//PA12	SPI1_MOSI
	//MODER bits = 10: Alternate function mode
	LDR		R1, =GPIOA_BASE_ADDR
	LDR		R2, =GPIOx_MODER_OFFSET
	ADDS	R1,	R2
	LDR		R0, [R1]
	MOVS	R2, 0x3
	LSLS	R3, R2, #2	//PA1
	MVNS	R3,	R3
	ANDS	R0, R3		//clear bits
	MOVS	R2, 0x2
	LSLS	R3, R2, #2
	ORRS	R0, R3
	MOVS	R2, 0x3
	LSLS	R3, R2, #22	//PA11
	MVNS	R3,	R3
	ANDS	R0, R3		//clear bits
	MOVS	R2, 0x2
	LSLS	R3, R2, #22
	ORRS	R0, R3
	MOVS	R2, 0x3
	LSLS	R3, R2, #24	//PA12
	MVNS	R3,	R3
	ANDS	R0, R3		//clear bits
	MOVS	R2, 0x2
	LSLS	R3, R2, #24
	ORRS	R0, R3
	STR		R0,	[R1]
	BX LR

