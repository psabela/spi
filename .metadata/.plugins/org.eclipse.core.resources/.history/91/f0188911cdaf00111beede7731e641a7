	MOVS	R2, 0x1
	LSLS	R3, R2, #16
	ORRS	R0, R3
	STR		R0,	[R1]
	BX LR

GPIOB_IDR_DIO_GET:
	LDR R1, =GPIOB_BASE_ADDR
	LDR R2, =GPIOx_IDR_OFFSET
	ADDS	R1, R2
	LDR		R0, [R1]
	BX LR

GPIOB_MODER_RESET_Output:
	//PB3  LORA RESET
	//00: Input mode
	//01: General purpose output mode
	//10: Alternate function mode
	//11: Analog mode (reset state)
	LDR		R1, =GPIOB_BASE_ADDR
	LDR		R2, =GPIOx_MODER_OFFSET
	ADDS	R1, R2
	LDR		R0, [R1]
	MOVS	R3, 0x3
	LSLS	R3, #6
	MVNS	R3, R3
	ANDS 	R0, R3  	//clear bits
	MOVS	R3, 0x1
	LSLS	R3, #6
	ORRS	R0, R3
	STR		R0, [R1]
	BX LR

