void read_buffer_command(uint8_t *cmd, uint8_t cmd_len, uint8_t payloadLen){

	tsize   = cmd_len;
	command = cmd;


	ASM_SPI_CR1_SPE_0();
	ASM_SPI_CFG1_FTHLV(tsize - 1);
	ASM_SPI_CR2_TSIZE(tsize);
	ASM_SPI_CR1_SPE_1();

	GPIOE_BSRR_NSS_RESET();  //LOW
	ASM_SPI_IER_TXPIE_Set();
	NVIC_SPI1_Enable_Interupt();
}

void lora_command(uint8_t *cmd, uint8_t cmd_len){

	tsize   = cmd_len;
	command = cmd;

	ASM_SPI_CR1_SPE_0();
	ASM_SPI_CFG1_FTHLV(tsize-1);
	ASM_SPI_CR2_TSIZE(tsize);
