	ASM_SPI_IER_TXPIE_Set();
	NVIC_SPI1_Enable_Interupt();
}


void SPI_RXP_IRQ_Packet_Available(){

		int num_words = (tsize + payloadLen + 3) / 4;   // ceiling division
		char buffer[tsize + 1];            // +1 for null terminator
		int idx = 0;
		uint16_t irq = 0;

		for (int i = 0; i < num_words; i++) {

		    rx_data = ASM_SPI_RXDR_Get();

		    if(lora_chip_irq_received_on_DIO == 1 && *command==GET_IRQ_STATUS){
		    	/*
		    	 * SPI_RXP_IRQ_Packet_Available following GET_IRQ_STATUS loRA command
		    	 */

		    	// byte 2-3 is IrqStatus(15:0)
		    	irq = (rx_data >>  16) & 0xFFFF;

				if (irq & 0x0002) {
					// RxDone → valid packet received
					printf("RxDone - valid packet received: %x\n", irq);
					lora_chip_RxDone_irq_received = 1;

				}
		    }

		    if(lora_chip_irq_received_on_DIO == 1 && lora_chip_RxDone_irq_received == 1 && *command==GET_RX_BUFFER_STATUS){
		    	/*
		    	 * SPI_RXP_IRQ_Packet_Available following GET_RX_BUFFER_STATUS loRA command
		    	 */

		    	payloadLen = (rx_data >> 16) & 0xFF;
				//startAddr  = (rx_data >> 24) & 0xFF;
		    	printf("payloadLen: %x\n", payloadLen);
		    	printf("HARD CODED startAddr: %x\n", startAddr);
		    	lora_offset_payloadlen_received = 1;
		    }

		    if (idx < tsize) buffer[idx++] = (rx_data >>  0) & 0xFF;
		    if (idx < tsize) buffer[idx++] = (rx_data >>  8) & 0xFF;
		    if (idx < tsize) buffer[idx++] = (rx_data >> 16) & 0xFF;
		    if (idx < tsize) buffer[idx++] = (rx_data >> 24) & 0xFF;
		}

		if(lora_chip_irq_received_on_DIO ==1 && lora_chip_RxDone_irq_received == 1 && *command==READ_BUFFER){

			buffer[idx] = '\0';               // null-terminate

			if (idx > 3) {
			    printf("%s\n", buffer + 3);
			} else {
			    printf("\n");                 // nothing left to print
			}
			lora_chip_RxDone_irq_received = 0;
			lora_chip_RxDone_irq_received = 0;
			lora_offset_payloadlen_received = 0;
		}
}

